{
  "name": "everygithub-gold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": { "everygithub": "./apps/agent/dist/cli.js" },
  "scripts": {
    "build": "npm run build:agent && npm run sync:hub",
    "build:agent": "node scripts/build-agent.mjs",
    "sync:hub": "node scripts/sync-protocol.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "agent": "node apps/agent/dist/cli.js",
    "hub": "cd apps/hub && npm run dev",
    "hub:install": "cd apps/hub && npm install",
    "hub:build": "npm run sync:hub && cd apps/hub && npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "commander": "^12.1.0",
    "execa": "^9.4.0",
    "fast-glob": "^3.3.2",
    "picocolors": "^1.1.0",
    "simple-git": "^3.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
